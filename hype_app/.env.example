# FinPulse Hype: скопируй в .env и заполни при необходимости (в git не попадает).
# Все переменные читаются с префиксом HYPE_.

HYPE_DB_PATH=data/hype.duckdb
HYPE_SEED_PATH=data/seed_articles.json

# AI-суммаризация (опционально): пусто -> детерминированный extractive-fallback без сети.
HYPE_LANGCHAIN_PROVIDER=
HYPE_LANGCHAIN_MODEL=gpt-4o-mini
# Ключ выбранного провайдера кладётся в его стандартную переменную окружения
# (например, для openai - OPENAI_API_KEY в твоём shell или .env, в репозиторий не пишется).
